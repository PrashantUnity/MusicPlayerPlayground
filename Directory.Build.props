<Project>
  <PropertyGroup>
    <!-- Suppress transitive package vulnerability warnings on legacy ImageSharp / Avalonia sub-dependencies -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>

    <!-- Shared Metadata for MusicPlayerPlayground -->
    <Authors>PrashantUnity; FryPDF Tools Team</Authors>
    <Company>FryPDF Tools Team</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PrashantUnity/MusicPlayerPlayground</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PrashantUnity/MusicPlayerPlayground</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="Exists('README.md')">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
